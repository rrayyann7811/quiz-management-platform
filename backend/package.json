{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed:demo": "node --env-file-if-exists=.env prisma/seed-demo.js",
    "seed:admin": "node --env-file-if-exists=.env prisma/seed-admin.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {"prisma": "6.19.0"}
}
